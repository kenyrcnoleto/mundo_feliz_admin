<div style="text-align: center;">
  <form method="post" action="/cliente/login" class="form-signin" style="width: 400px; display: inline-block">
      <h1 class="h3 mb-3 fw-normal">Já é cliente? Faça o seu login</h1>

      <div class="form-floating">
        <input type="email" class="form-control" name="email" id="email" placeholder="nome@examplo.com">
        <label for="email">Email </label>
      </div>
      <div class="form-floating">
        <input type="password" class="form-control" name="senha" id="senha" placeholder="Senha">
        <label for="senha">Senha</label>
      </div>

      <div class="form-check text-start my-3">
        <input class="form-check-input" type="checkbox" value="1" name="lembrar" id="flexCheckDefault">
        <label class="form-check-label" for="flexCheckDefault">
          Lembrar de mim
        </label>
      </div>
      <button class="btn btn-primary w-100 py-2" type="submit">Login</button>
    </form>
  <hr>
  <div style="padding-top: 30px;padding-botton: 30px; width: 400px; display: inline-block;" >
    <h1 class="h3 mb-3 fw-normal">Não é cliente? Faça o seu cadastro</h1>
    <a href="/cliente/cadastrar" class="btn btn-primary" >Cadastrar</a >
  </div>
</div>